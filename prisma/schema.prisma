generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- MODUL AUTH & 2FA ---
model User {
  id                  String          @id @default(uuid())
  email               String          @unique
  name                String
  password            String   
  role                String          @default("KASIR") // "OWNER", "FINANCE", "KASIR"
  status              String          @default("ACTIVE") // "ACTIVE", "SUSPENDED", "ARCHIVED"
  suspendedAt         DateTime?
  permissions         String[]        @default([]) // Dynamic Feature Flags / Hak Akses Fitur
  isTwoFactorEnabled  Boolean         @default(false)
  twoFactorSecret     String?  

  receivedWarnings    WarningLetter[] @relation("ReceivedWarnings")
  issuedWarnings      WarningLetter[] @relation("IssuedWarnings")
}

// --- MODUL SDM: SURAT PERINGATAN (WARNING LETTER) ---
model WarningLetter {
  id          String   @id @default(uuid())
  userId      String   // ID Karyawan yang kena SP
  reason      String   @db.Text
  issuedById  String   // ID Owner yang memberi SP
  createdAt   DateTime @default(now())
  
  user        User     @relation("ReceivedWarnings", fields: [userId], references: [id], onDelete: Cascade)
  issuedBy    User     @relation("IssuedWarnings", fields: [issuedById], references: [id], onDelete: Cascade)
}

// --- MODUL 1: BAGAN AKUN (COA) ---
model ChartOfAccount {
  code          String        @id
  name          String
  type          String        // ASET, KEWAJIBAN, EKUITAS, PENDAPATAN, BEBAN
  normalBalance String        // DEBIT, KREDIT
  isProtected   Boolean       @default(false)
  
  journalLines  JournalLine[]
}

// --- MODUL 4: JURNAL UMUM ---
model JournalEntry {
  id          String        @id @default(uuid())
  tanggal     DateTime      @default(now())
  keterangan  String
  sourceType  String        // "POS", "SERVICE", "CASHFLOW", "MANUAL", "PURCHASE_UNIT", "RESTOCK"
  sourceId    String?       
  status      String        @default("POSTED") // "DRAFT", "POSTED", "REJECTED"
  total       Decimal       @db.Decimal(15, 2)
  isEdited    Boolean       @default(false)
  
  // Audit Trail
  createdBy   String?
  approvedBy  String?
  approvedAt  DateTime?
  
  lines       JournalLine[]
  productUnit ProductUnit?

  @@index([tanggal])
  @@index([status])
  @@index([sourceType])
}

model JournalLine {
  id           String         @id @default(uuid())
  entryId      String
  accountCode  String
  side         String         // "DEBIT", "KREDIT"
  nominal      Decimal        @db.Decimal(15, 2)
  
  entry        JournalEntry   @relation(fields: [entryId], references: [id], onDelete: Cascade)
  account      ChartOfAccount @relation(fields: [accountCode], references: [code])

  @@index([accountCode])
  @@index([entryId])
}

// --- MODUL KATALOG INDUK & ITEM FISIK (PRODUCT MODEL + UNIT & QC) ---
model ProductModel {
  id          String        @id @default(uuid())
  sku         String        @unique // Contoh: L-THINK-T480
  name        String        // Contoh: Lenovo ThinkPad T480 i5 8/256
  category    String        // "LAPTOP", "AKSESORIS"
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  
  units       ProductUnit[]
}

model ProductUnit {
  id                String       @id @default(uuid())
  serialNumber      String       @unique // Wajib scan fisik
  condition         String       // "NEW", "SECOND"
  grade             String?      // "A", "B", "C" (null jika NEW)
  hpp               Decimal      @db.Decimal(15, 2)
  price             Decimal      @db.Decimal(15, 2)
  status            String       @default("AVAILABLE") // "QC_PENDING", "AVAILABLE", "IN_REPAIR", "SOLD"

  // --- QC CHECKLIST ---
  isFisikNormal     Boolean      @default(true)
  isMesinNormal     Boolean      @default(true)
  isStorageNormal   Boolean      @default(true)
  isSuhuNormal      Boolean      @default(true)
  isKeyboardNormal  Boolean      @default(true)
  isTouchpadNormal  Boolean      @default(true)
  isPortNormal      Boolean      @default(true)
  isWebcamNormal    Boolean      @default(true)
  catatanFisik      String?      @db.Text 

  // --- RELASI KE KATALOG INDUK ---
  productModelId    String
  productModel      ProductModel @relation(fields: [productModelId], references: [id], onDelete: Cascade)

  // Maker-Checker & Journal Relation
  purchaseJournalId String?       @unique
  purchaseJournal   JournalEntry? @relation(fields: [purchaseJournalId], references: [id], onDelete: SetNull)

  // Audit Trail
  createdBy         String?
  approvedBy        String?
  approvedAt        DateTime?

  transactions      PosTransaction[]

  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@index([status])
  @@index([productModelId])
}

model CashierShift {
  id                  String    @id @default(uuid())
  userId              String    // ID user Kasir
  startTime           DateTime  @default(now())
  endTime             DateTime?
  startingCash        Decimal   @db.Decimal(15, 2) // Modal awal (kembalian) di laci
  expectedEndingCash  Decimal?  @db.Decimal(15, 2) // Perhitungan sistem
  actualEndingCash    Decimal?  @db.Decimal(15, 2) // Uang fisik yang dihitung kasir
  status              String    @default("OPEN")  // OPEN, CLOSED

  transactions        PosTransaction[]

  @@index([userId, status])
}

model PosTransaction {
  id             String        @id @default(uuid())
  invoiceNumber  String?       @unique
  status         String        @default("SUCCESS") // "SUCCESS", "VOID"
  paymentMethod  String        @default("CASH")    // "CASH", "TRANSFER"
  tanggal        DateTime      @default(now())
  serialNumber   String
  productUnitId  String?
  productUnit    ProductUnit?  @relation(fields: [productUnitId], references: [id])
  totalPrice     Decimal       @db.Decimal(15, 2)
  totalHpp       Decimal       @db.Decimal(15, 2) 
  cashierName    String?
  journalEntryId String?
  shiftId        String?
  shift          CashierShift? @relation(fields: [shiftId], references: [id])

  // Audit Trail
  createdBy      String?
  approvedBy     String?
  approvedAt     DateTime?

  @@index([tanggal])
  @@index([status])
  @@index([shiftId])
}